{
  "rules": {
    ".read": "query.orderByKey == true && query.endAt == '~'",
    ".write": "auth != null && root.child('~admin').child(auth.uid).child('until').val() > now",
    "reviews": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() ? root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('by').val() : root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.child('by').val() && (!newData.exists() || newData.child('by').val() === data.child('by').val())",
        ".validate": "newData.child('week').isNumber() && newData.child('who').isString() && newData.child('who').val() !== newData.child('by').val() && newData.child('by').isString() && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500",
        "replies": {
          "$rid": {
            ".validate": "newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500 && newData.child('ts').isNumber()",
            ".write": "newData.exists() ? !data.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('by').val() : root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.child('by').val()"
          }
        },
        "likes": {
          "$name": {
            ".validate": "newData.val() === true && (root.child('cfg/people').hasChild($name) || root.child('cfg/guests').hasChild($name))",
            ".write": "root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === $name"
          }
        }
      }
    },
    "marks": {
      ".read": true,
      "$week": {
        "$name": {
          "$by": {
            ".write": "root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === $by && $by !== (root.child('subs').child($week).child($name).child('ok').exists() ? root.child('subs').child($week).child($name).child('to').val() : $name)",
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 5 && root.child('cfg/people').hasChild($name)"
          }
        }
      }
    },
    "cleaned": {
      ".read": true,
      "$week": {
        "$name": {
          ".write": "root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === (root.child('subs').child($week).child($name).child('ok').exists() ? root.child('subs').child($week).child($name).child('to').val() : $name)",
          ".validate": "newData.isNumber() && root.child('cfg/people').hasChild($name)"
        }
      }
    },
    "accepted": {
      ".read": true,
      "$week": {
        "$name": {
          ".write": "root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() !== null",
          ".validate": "newData.isNumber() && root.child('cfg/people').hasChild($name)"
        }
      }
    },
    "paper": {
      ".read": true,
      ".write": "newData.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('by').val()",
      ".validate": "newData.child('rolls').isNumber() && newData.child('rolls').val() % 1 === 0 && newData.child('rolls').val() >= 0 && newData.child('rolls').val() <= 99 && newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('ts').isNumber()"
    },
    "game": {
      ".read": true,
      "$week": {
        "$name": {
          ".write": "newData.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === $name",
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000 && (!data.exists() || newData.val() > data.val())"
        }
      }
    },
    "trash": {
      ".read": true,
      ".write": "newData.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('by').val()",
      ".validate": "newData.child('full').isBoolean() && newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('ts').isNumber() && (!newData.child('with').exists() || newData.child('with').isString() && newData.child('with').val().length <= 20)"
    },
    "trashOut": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() && newData.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('by').val()",
        ".validate": "newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('ts').isNumber() && (!newData.child('with').exists() || newData.child('with').isString() && newData.child('with').val().length <= 20)"
      }
    },
    "buys": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() ? root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('by').val() : !newData.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.child('by').val()",
        ".validate": "newData.child('n').isNumber() && newData.child('n').val() % 1 === 0 && newData.child('n').val() >= 1 && newData.child('n').val() <= 99 && newData.child('price').isNumber() && newData.child('price').val() > 0 && newData.child('price').val() <= 100000 && newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('ts').isNumber()",
        "paid": {
          "$name": {
            ".write": "root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.parent().parent().child('by').val()",
            ".validate": "newData.isNumber() && root.child('cfg/people').hasChild($name)"
          }
        },
        "claim": {
          "$name": {
            ".write": "root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === $name || !newData.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.parent().parent().child('by').val()",
            ".validate": "newData.isNumber() && root.child('cfg/people').hasChild($name)"
          }
        }
      }
    },
    "deeds": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() ? root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('by').val() : !newData.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.child('by').val()",
        ".validate": "newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 200 && newData.child('ts').isNumber()",
        "votes": {
          "$name": {
            ".write": "root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === $name",
            ".validate": "newData.isNumber() && $name !== newData.parent().parent().child('by').val() && (root.child('cfg/people').hasChild($name) || root.child('cfg/guests').hasChild($name))"
          }
        }
      }
    },
    "~photos": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() ? root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.parent().parent().child('deeds').child($id).child('by').val() : !newData.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === root.child('deeds').child($id).child('by').val()",
        ".validate": "newData.child('before').isString() && newData.child('before').val().beginsWith('data:image/jpeg;base64,') && newData.child('before').val().length <= 300000 && newData.child('after').isString() && newData.child('after').val().beginsWith('data:image/jpeg;base64,') && newData.child('after').val().length <= 300000"
      }
    },
    "requests": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() ? root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('by').val() : root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.child('by').val() && (!newData.exists() ? !data.child('ok').exists() : newData.child('by').val() === data.child('by').val())",
        ".validate": "(newData.child('kind').val() === 'fix' || newData.child('kind').val() === 'buy') && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 200 && newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('ts').isNumber()",
        "done": {
          ".write": "!data.exists() ? newData.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('by').val() : !newData.exists() && !data.parent().child('ok').exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() !== null",
          ".validate": "newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('ts').isNumber()"
        },
        "ok": {
          ".write": "!data.exists() && data.parent().child('done').exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() !== null",
          ".validate": "newData.isNumber()"
        },
        "price": {
          "$name": {
            ".write": "root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === $name && $name !== data.parent().parent().child('done').child('by').val() && !data.parent().parent().child('ok').exists()",
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 5 && (root.child('cfg/people').hasChild($name) || root.child('cfg/guests').hasChild($name))"
          }
        }
      }
    },
    "events": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() ? root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('by').val() : root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.child('by').val() && (!newData.exists() || newData.child('by').val() === data.child('by').val())",
        ".validate": "newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 100 && newData.child('date').isString() && newData.child('date').val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && (!newData.child('time').exists() || newData.child('time').isString() && newData.child('time').val().matches(/^[0-2][0-9]:[0-5][0-9]$/)) && newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('ts').isNumber()",
        "votes": {
          "$name": {
            ".write": "root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === $name",
            ".validate": "newData.val() === true && (root.child('cfg/people').hasChild($name) || root.child('cfg/guests').hasChild($name))"
          }
        }
      }
    },
    "subs": {
      ".read": true,
      "$week": {
        "$name": {
          ".write": "!data.exists() ? root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === $name && (!newData.child('ok').exists() || newData.child('back').exists()) : !newData.exists() && !data.child('ok').exists() && (root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === $name || root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.child('to').val())",
          ".validate": "root.child('cfg/people').hasChild($name) && newData.child('to').isString() && newData.child('to').val() !== $name && root.child('cfg/people').hasChild(newData.child('to').val()) && newData.child('ts').isNumber() && (!newData.child('back').exists() || newData.child('back').isNumber())",
          "ok": {
            ".write": "!data.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.parent().child('to').val()",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "bossSubs": {
      ".read": true,
      "$week": {
        ".write": "!data.exists() ? root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === newData.child('from').val() && (!newData.child('ok').exists() || newData.child('back').exists()) : !newData.exists() && !data.child('ok').exists() && (root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.child('from').val() || root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.child('to').val())",
        ".validate": "newData.child('from').isString() && newData.child('to').isString() && newData.child('to').val() !== newData.child('from').val() && root.child('cfg/people').hasChild(newData.child('to').val()) && newData.child('ts').isNumber() && (!newData.child('back').exists() || newData.child('back').isNumber())",
        "ok": {
          ".write": "!data.exists() && root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === data.parent().child('to').val()",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "logins": {
      ".read": true
    },
    "cfg": {
      ".read": true
    },
    "bonus": {
      ".read": true,
      "$id": {
        ".validate": "newData.child('who').isString() && newData.child('pts').isNumber() && newData.child('why').isString() && newData.child('why').val().length <= 200 && newData.child('ts').isNumber()"
      }
    },
    "~codes": {
      "$name": {
        ".read": "root.child('logins').child(auth.token.email.replace('@socochka.app', '')).val() === $name",
        ".validate": "false"
      }
    },
    "~admin": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".validate": "false"
      }
    },
    "~login": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid",
        ".validate": "newData.child('codes').isString() && newData.child('codes').val().length <= 40 && newData.child('ts').val() === now",
        "codes": {
          ".validate": true
        },
        "ts": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
